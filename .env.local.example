UMAMI_URL=http://localhost:3001

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MILYFE_INSTANCE_ID=local-dev

# Cron jobs
CRON_SECRET=generate-a-random-secret-here

# Mi AI Helper (any OpenAI-compatible API)
OPENAI_API_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
MI_MODEL=llama3.2:3b

# Mi AI Fallback (if primary is down — e.g. OpenAI as backup for Ollama)
MI_FALLBACK_API_BASE_URL=https://api.openai.com/v1
MI_FALLBACK_API_KEY=sk-...
MI_FALLBACK_MODEL=gpt-4o-mini
